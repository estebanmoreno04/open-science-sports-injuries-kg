        <https://semopenalex.org/author/A5035214950>,
        <https://semopenalex.org/author/A5042727391>,
        <https://semopenalex.org/author/A5051886581>,
        <https://semopenalex.org/author/A5053871615>,
        <https://semopenalex.org/author/A5056935954>,
        <https://semopenalex.org/author/A5062183401>,
        <https://semopenalex.org/author/A5084594257>,
        <https://semopenalex.org/author/A5085330293>,
        <https://semopenalex.org/author/A5088828476> ;
    ont:openAlexId "W4322616850"^^xsd:string ;
    ont:publicationYear 2023 ;
    ont:title "Indirect Rectus Femoris Injury Mechanisms in Professional Soccer Players: Video Analysis and Magnetic Resonance Imaging Findings"^^xsd:string ;
