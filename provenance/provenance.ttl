:semopenalex_sparql    prov:actedOnBehalfOf  :grupo_osai_rse .
:openaire_api          prov:actedOnBehalfOf  :grupo_osai_rse .
:sentence_transformers prov:actedOnBehalfOf  :grupo_osai_rse .
:bertopic              prov:actedOnBehalfOf  :grupo_osai_rse .
:lda_sklearn           prov:actedOnBehalfOf  :grupo_osai_rse .
:bert_base_ner         prov:actedOnBehalfOf  :grupo_osai_rse .
:grant_regex           prov:actedOnBehalfOf  :grupo_osai_rse .
:rdflib                prov:actedOnBehalfOf  :grupo_osai_rse .
:ro_crate_py           prov:actedOnBehalfOf  :grupo_osai_rse .


## ============================================================
##  PIPELINE PARAMETERS  (recorded as prov:Entity for
##                         reproducibility)
## ============================================================

:params_similarity  a  prov:Entity ;
    rdfs:label    "Similarity parameters" ;
    dcterms:description
        "embeddingModel = all-MiniLM-L6-v2 ; similarityThreshold = 0.75" .

:params_topic_bert  a  prov:Entity ;
    rdfs:label    "BERTopic parameters" ;
    dcterms:description
        "UMAP(n_neighbors=5, n_components=5, min_dist=0.0, metric=cosine) ; HDBSCAN(min_cluster_size=3, min_samples=1) ; topicThreshold = 0.4" .

:params_topic_lda  a  prov:Entity ;
    rdfs:label    "LDA parameters" ;
    dcterms:description
        "n_components = 5 ; max_iter = 30 ; learning_method = online ; max_df = 0.90 ; min_df = 2 ; topicThreshold = 0.4" .

:params_ner  a  prov:Entity ;
    rdfs:label    "NER parameters" ;
    dcterms:description
        "model = dslim/bert-base-NER ; aggregation_strategy = simple ; device = cpu ; confidence_threshold = 0.70 ; min_entity_length = 2 chars ; grant_id_detection = regex (NIH, NSF, DOD, ONR, EU patterns)" .

:A05_embeddings_similarity  prov:used  :params_similarity .
:A06_topic_modeling          prov:used  :params_topic_bert .
:A06_topic_modeling          prov:used  :params_topic_lda .
:A07_ner_acknowledgements    prov:used  :params_ner .
