classDiagram

    class Paper {
        String title
        String abstractText
        String doi
        int publicationYear
        String paperURL
        String openAlexId
        String externalKeyword
    }

    class Person {
        String name
        String orcid
        String givenName
        String familyName
    }

    class Organization {
        String name
        String countryName
        String countryCode
        String organizationType
        String openAlexId
    }

    class Project {
        String projectName
        String grantId
    }

    class Venue {
        String venueName
        String venueType
    }

    Paper --> Person : hasAuthor
    Person --> Organization : affiliatedWith
    Paper --> Person : acknowledges
    Paper --> Organization : acknowledges
    Paper --> Project : relatedToProject
    Paper --> Venue : publishedIn

    note for Paper "owl:sameAs links to SemOpenAlex work URI\n(W3C standard property, not defined here)"
    note for Person "owl:sameAs links to SemOpenAlex author URI"
    note for Organization "owl:sameAs links to SemOpenAlex institution URI"

    class TopicAssignment {
        <<N-ary>>
        float confidenceScore
        float topicThreshold
        String assignmentDate
        String modelUsed
    }

    class SimilarityLink {
        <<N-ary>>
        float similarityScore
        float similarityThreshold
        String calculationDate
        String modelUsed
    }

    class Topic {
        String topicName
        String topicDescription
        String topTerms
    }

    Paper --> TopicAssignment : hasTopicAssignment
    TopicAssignment --> Topic : assignedToTopic
    Paper --> SimilarityLink : hasSimilarity
    SimilarityLink --> Paper : isSimilarToPaper

    class BodyPart {
        String bodyPartName
        String bodyRegion
        String synonymLabel
    }

    class Injury {
        String injuryName
        String injuryCategory
        String injuryDescription
    }

    class TreatmentMethod {
        String treatmentName
        String treatmentType
        String treatmentDescription
    }

    class Sport {
        String sportName
    }

    class ClinicalMeasure {
        String measureName
        String measureUnit
    }

    Paper --> Injury : studiesInjury
    Injury --> BodyPart : affectsBodyPart
    Paper --> BodyPart : focusesOnBodyPart
    Paper --> TreatmentMethod : describesTreatment
    TreatmentMethod --> Injury : appliedToInjury
    Paper --> Sport : evaluatedInSport
    Paper --> ClinicalMeasure : reportsMeasure