# Example SPARQL queries for the Sports Injuries Knowledge Graph
# These queries can be executed over kg/sports_injuries_kg.ttl using any RDF/SPARQL tool.

PREFIX sio: <http://kg.sports-injuries.org/ontology/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

###############################################################################
# 1. List all papers with title, year and DOI
###############################################################################

SELECT ?paper ?title ?year ?doi
WHERE {
  ?paper a sio:Paper ;
         sio:title ?title ;
         sio:publicationYear ?year .
  OPTIONAL { ?paper sio:doi ?doi . }
}
ORDER BY ?year ?title


###############################################################################
# 2. List papers and their SemOpenAlex external links
###############################################################################

SELECT ?paper ?title ?sameAs
WHERE {
  ?paper a sio:Paper ;
         sio:title ?title ;
         owl:sameAs ?sameAs .
}
ORDER BY ?paper


###############################################################################
# 3. List papers and their external keywords from OpenAIRE
###############################################################################

SELECT ?paper ?title ?keyword
WHERE {
  ?paper a sio:Paper ;
         sio:title ?title ;
         sio:externalKeyword ?keyword .
}
ORDER BY ?paper ?keyword


###############################################################################
# 4. Count number of external keywords per paper
###############################################################################

SELECT ?paper ?title (COUNT(?keyword) AS ?numKeywords)
WHERE {
  ?paper a sio:Paper ;
         sio:title ?title .
  OPTIONAL { ?paper sio:externalKeyword ?keyword . }
}
GROUP BY ?paper ?title
ORDER BY DESC(?numKeywords)


###############################################################################
# 5. List topic assignments with confidence score
###############################################################################

SELECT ?paper ?title ?topic ?topicName ?score ?model
WHERE {
  ?paper a sio:Paper ;
         sio:title ?title ;
         sio:hasTopicAssignment ?assignment .

  ?assignment sio:assignedToTopic ?topic ;
              sio:confidenceScore ?score .

  OPTIONAL { ?assignment sio:modelUsed ?model . }
  OPTIONAL { ?topic sio:topicName ?topicName . }
}
ORDER BY ?topic DESC(?score)


###############################################################################
# 6. List the most similar paper pairs
###############################################################################

SELECT ?sourcePaper ?targetPaper ?score ?threshold ?model
WHERE {
  ?sourcePaper sio:hasSimilarity ?similarityLink .

  ?similarityLink sio:isSimilarToPaper ?targetPaper ;
                  sio:similarityScore ?score .

  OPTIONAL { ?similarityLink sio:similarityThreshold ?threshold . }
  OPTIONAL { ?similarityLink sio:modelUsed ?model . }
}
ORDER BY DESC(?score)


###############################################################################
# 7. List papers similar to a selected paper
# Replace P10 with the desired paper identifier.
###############################################################################

SELECT ?sourcePaper ?targetPaper ?targetTitle ?score
WHERE {
  ?sourcePaper sio:paperId "P10"^^xsd:string ;
               sio:hasSimilarity ?similarityLink .

  ?similarityLink sio:isSimilarToPaper ?targetPaper ;
                  sio:similarityScore ?score .

  ?targetPaper sio:title ?targetTitle .
}
ORDER BY DESC(?score)


###############################################################################
# 8. List acknowledged entities extracted with NER
# This query will return results once ner_entities.csv has been integrated.
###############################################################################

SELECT ?paper ?title ?entity ?entityName
WHERE {
  ?paper a sio:Paper ;
         sio:title ?title ;
         sio:acknowledges ?entity .

  ?entity sio:name ?entityName .
}
ORDER BY ?paper ?entityName


###############################################################################
# 9. List acknowledged organizations only
# This query will return results once NER entities have been integrated.
###############################################################################

SELECT ?paper ?title ?organization ?organizationName
WHERE {
  ?paper a sio:Paper ;
         sio:title ?title ;
         sio:acknowledges ?organization .

  ?organization a sio:Organization ;
                sio:name ?organizationName .
}
ORDER BY ?paper ?organizationName


###############################################################################
# 10. List papers related to projects or grants
###############################################################################

SELECT ?paper ?title ?project ?projectName ?grantId
WHERE {
  ?paper a sio:Paper ;
         sio:title ?title ;
         sio:relatedToProject ?project .

  OPTIONAL { ?project sio:projectName ?projectName . }
  OPTIONAL { ?project sio:grantId ?grantId . }
}
ORDER BY ?paper